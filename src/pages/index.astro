---
import Layout from "../layouts/Layout.astro";
import TypeCard from "../components/TypeCard.astro";
import { getIndexData } from "../lib/data";

const index = getIndexData();
---

<Layout title="Dashboard">
  <h1 class="text-2xl font-bold mb-6">Dashboard</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
    <TypeCard
      href="/projects/"
      label="Projects"
      count={index.projects.length}
      description={`${index.projects.reduce((s, p) => s + p.sessionCount, 0)} sessions across all projects`}
    />
    <TypeCard
      href="/plans/"
      label="Plans"
      count={index.plans.length}
      description="Markdown plan files"
    />
    <TypeCard
      href="/shell-snapshots/"
      label="Shell Snapshots"
      count={index.shellSnapshots.length}
      description="Shell environment captures"
    />
    <TypeCard
      href="/todos/"
      label="Todos"
      count={index.todos.length}
      description="Non-empty task lists"
    />
    <TypeCard
      href="/file-history/"
      label="File History"
      count={index.fileHistory.length}
      description="Conversations with file backups"
    />
  </div>

  <h2 class="text-lg font-semibold mb-4">Recent Conversations</h2>
  <div class="space-y-2">
    {index.history.slice(0, 50).map((entry) => (
      <div class="flex items-baseline gap-3 text-sm">
        <span class="text-zinc-500 shrink-0 tabular-nums">
          {new Date(entry.timestamp).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
          })}
        </span>
        <span class="text-zinc-300 truncate">{entry.display}</span>
        <span class="text-zinc-600 text-xs truncate shrink-0">
          {entry.project}
        </span>
      </div>
    ))}
  </div>
</Layout>
