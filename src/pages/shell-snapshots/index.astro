---
import Layout from "../../layouts/Layout.astro";
import { getIndexData } from "../../lib/data";
import { formatTimestamp, formatBytes } from "../../lib/format";

const { shellSnapshots } = getIndexData();
---

<Layout title="Shell Snapshots">
  <h1 class="text-2xl font-bold mb-6">Shell Snapshots</h1>

  <div class="space-y-2">
    {shellSnapshots.map((snap) => (
      <a
        href={`/shell-snapshots/${snap.fileName.replace(".sh", "")}/`}
        class="flex items-baseline justify-between gap-4 p-3 rounded bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition-colors"
      >
        <span class="text-zinc-200 font-mono text-sm truncate">
          {snap.fileName}
        </span>
        <div class="flex gap-4 shrink-0">
          <span class="text-zinc-500 text-xs">
            {formatTimestamp(snap.timestamp)}
          </span>
          <span class="text-zinc-500 text-xs">{formatBytes(snap.sizeBytes)}</span>
        </div>
      </a>
    ))}
  </div>
</Layout>
