---
import Layout from "../../../layouts/Layout.astro";
import BackLink from "../../../components/BackLink.astro";
import SessionsList from "../../../components/SessionsList";
import { getIndexData } from "../../../lib/data";

export function getStaticPaths() {
  const { projects } = getIndexData();
  return projects.map((project) => ({
    params: { dirName: project.dirName },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={project.displayName}>
  <BackLink href="/projects/" label="Projects" />
  <h1 class="text-2xl font-bold mb-2">{project.displayName}</h1>
  <p class="text-zinc-500 text-sm mb-6">{project.sessionCount} sessions</p>
  <SessionsList client:load sessions={project.sessions} dirName={project.dirName} />
</Layout>
