---
interface Props {
  href: string;
  label: string;
  count: number;
  description: string;
}

const { href, label, count, description } = Astro.props;
---

<a
  href={href}
  class="block p-6 bg-zinc-900 border border-zinc-800 rounded-lg hover:border-zinc-700 transition-colors"
>
  <div class="text-3xl font-bold text-zinc-100 mb-1">{count}</div>
  <div class="text-sm font-medium text-zinc-300 mb-2">{label}</div>
  <div class="text-xs text-zinc-500">{description}</div>
</a>
