---
const links = [
  { href: "/", label: "Dashboard" },
  { href: "/projects/", label: "Projects" },
  { href: "/plans/", label: "Plans" },
  { href: "/shell-snapshots/", label: "Shell Snapshots" },
  { href: "/todos/", label: "Todos" },
  { href: "/file-history/", label: "File History" },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 w-56 h-screen bg-zinc-900 border-r border-zinc-800 p-4 overflow-y-auto">
  <a href="/" class="block text-lg font-semibold text-zinc-100 mb-6">
    Claude History
  </a>
  <ul class="space-y-1">
    {links.map(({ href, label }) => {
      const isActive = href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(href);
      return (
        <li>
          <a
            href={href}
            class:list={[
              "block px-3 py-2 rounded text-sm",
              isActive
                ? "bg-zinc-800 text-zinc-100"
                : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50",
            ]}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
